{
  "name": "@playground/getting-started-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:client": "BUILD_TARGET=client vite build --outDir dist/client",
    "build:server": "BUILD_TARGET=server vite build --outDir dist/server --ssr src/entry-server.tsx",
    "build": "pnpm build:client && pnpm build:server",
    "preview": "vite preview",
    "test": "pnpm build:server && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@dathra/components": "workspace:*",
    "@dathra/core": "workspace:*",
    "@dathra/runtime": "workspace:*"
  },
  "devDependencies": {
    "@dathra/config": "workspace:*",
    "@dathra/plugin": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "~5.8.3",
    "vite": "^6.3.4",
    "vitest": "catalog:"
  }
}
