{
  "name": "@playground/nuxt",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "fmt": "oxfmt --ignore-path ../../.gitignore --no-error-on-unmatched-pattern --write \"**/*.{ts,tsx,js,mjs,cjs,cts,mts,json,vue}\"",
    "fmt:check": "oxfmt --ignore-path ../../.gitignore --no-error-on-unmatched-pattern --check \"**/*.{ts,tsx,js,mjs,cjs,cts,mts,json,vue}\"",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dathra/components": "workspace:*",
    "@dathra/core": "workspace:*",
    "@dathra/reactivity": "workspace:*",
    "@dathra/runtime": "workspace:*",
    "nuxt": "^4.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@dathra/config": "workspace:*",
    "@dathra/plugin": "workspace:*",
    "@nuxt/devtools": "^3.1.1",
    "@types/node": "catalog:",
    "playwright": "^1.56.1",
    "vitest": "catalog:"
  }
}
