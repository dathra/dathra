{
  "name": "dathra-workspace",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "build": "pnpm p:shared build && pnpm p:reactivity build && pnpm p:store build && pnpm p:components build && pnpm p:runtime build && pnpm p:transformer build && pnpm p:plugin build && pnpm p:core build",
    "build:apps": "pnpm -r --workspace-concurrency=1 --filter \"./docs\" --filter \"./playgrounds/**\" run build",
    "cfg": "pnpm --filter @dathra/config",
    "p:components": "pnpm --filter @dathra/components",
    "p:core": "pnpm --filter @dathra/core",
    "p:plugin": "pnpm --filter @dathra/plugin",
    "p:reactivity": "pnpm --filter @dathra/reactivity",
    "p:runtime": "pnpm --filter @dathra/runtime",
    "p:transformer": "pnpm --filter @dathra/transformer",
    "p:shared": "pnpm --filter @dathra/shared",
    "p:store": "pnpm --filter @dathra/store",
    "pg:e2e": "pnpm --filter @playground/e2e",
    "pg:vanilla": "pnpm --filter @playground/vanilla",
    "pg:ssr": "pnpm --filter @playground/ssr",
    "docs": "pnpm --filter @dathra/docs dev",
    "docs:preview": "pnpm --filter @dathra/docs preview",
    "version": "printf '\\033[1;36m%-10s | %-10s | %-10s\\033[0m\\n' tool version which; printf '%-10s | %-10s | %-10s\\n' ---------- ---------- ----------; printf '%-10s | %-10s | %-10s\\n' '@antfu/ni' '' \"$(which ni)\"; printf '%-10s | %-10s | %-10s\\n' node \"$(node -v)\" \"$(which node)\"; printf '%-10s | %-10s | %-10s\\n' pnpm \"v$(pnpm -v)\" \"$(which pnpm)\"",
    "release:all": "nr p:shared release && nr p:reactivity release && nr p:store release && nr p:components release && nr p:runtime release && nr p:core release && nr p:transformer release && nr p:plugin release",
    "review:evidence": "node config/reviewEvidence/implementation.mjs",
    "test:e2e": "pnpm --filter @playground/e2e test",
    "test:review-evidence": "node --test config/reviewEvidence/implementation.test.mjs",
    "test:apps": "pnpm -r --workspace-concurrency=1 --filter \"./docs\" --filter \"./playgrounds/**\" run test",
    "test": "pnpm -r --filter \"./packages/**\" --workspace-concurrency=1 run test",
    "dev": "pnpm -r --filter \"./packages/**\" --parallel run dev",
    "lint": "pnpm -r --filter \"./packages/**\" --parallel run lint",
    "lint:type-aware": "pnpm build && pnpm -r --filter \"./packages/**\" --parallel run lint:type-aware",
    "fmt": "pnpm -r --filter \"./packages/**\" --filter \"./playgrounds/**\" --filter \"./docs\" --parallel run fmt",
    "fmt:check": "pnpm -r --filter \"./packages/**\" --filter \"./playgrounds/**\" --filter \"./docs\" --parallel run fmt:check",
    "typecheck": "pnpm -r --filter \"./packages/**\" --parallel run typecheck"
  },
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.2.19",
    "rlse.ts": "catalog:",
    "typescript": "catalog:"
  }
}
